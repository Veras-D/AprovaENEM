# ==============================================================================
# AprovaENEM — Global Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Project & Environment
PROJECT_NAME=aprovaenem
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
DB_USER=aprovaenem_user
DB_PASSWORD=aprovaenem_secure_password_2026

AUTH_DB_NAME=auth_db
EXAM_DB_NAME=exam_db
NOTIFICATION_DB_NAME=notification_db

# ------------------------------------------------------------------------------
# Redis 7+ Cache & Leaderboard Grid
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redis_secure_password_2026
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=aprovaenem_rabbit
RABBITMQ_DEFAULT_PASS=rabbit_secure_password_2026
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ------------------------------------------------------------------------------
# JWT Security & Password Pepper (Spring Security 6)
# ------------------------------------------------------------------------------
# Minimum 256-bit secret key for HMAC-SHA256 signature
JWT_SECRET=super_secret_jwt_key_for_aprovaenem_at_least_256_bits_long_2026!
JWT_EXPIRATION_MS=86400000

# Application-level secret pepper layered over BCrypt (HMAC-SHA256 pre-hash)
AUTH_PASSWORD_PEPPER=aprovaenem_secret_pepper_key_2026_at_least_256_bits!

# ------------------------------------------------------------------------------
# Google Gemini Generative AI (Socratic AI Tutor & RAG)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# CORS & Ingress Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Grafana APM Telemetry Credentials
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password_2026

# ------------------------------------------------------------------------------
# Transactional Email (SMTP)
# Default (development): Bundled Mailpit container captures all emails locally at http://localhost:8025
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=no-reply@aprovaenem.local
APP_MAIL_FROM_NAME=AprovaENEM
APP_FRONTEND_URL=http://localhost
