            ],
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns notification feed', function () {",
                  "    pm.expect(json.notifications).to.be.an('array');",
                  "    if (json.notifications && json.notifications.length > 0) {",
                  "        pm.environment.set('notificationId', json.notifications[0].id);",
                  "    }",
                  "});"
