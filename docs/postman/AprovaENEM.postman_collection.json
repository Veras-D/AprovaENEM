{
  "info": {
    "_postman_id": "8f3b2d1e-9a4c-4e8b-b7c1-2a9d8e7f6c5b",
    "name": "AprovaENEM — Comprehensive API Contract Test Suite",
    "description": "Production API contract verification suite for AprovaENEM microservices covering Auth, Exam, Socratic AI Tutor, Gamification, and Notifications via Nginx Edge and Spring Cloud Gateway BFF.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ingress & Perimeter Security",
      "item": [
        {
          "name": "CORS Preflight Request (OPTIONS /api/v1/sessions)",
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "http://localhost:3000" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "Authorization,Content-Type,X-Session-Id" }
            ],
            "url": { "raw": "{{baseUrl}}/sessions", "host": ["{{baseUrl}}"], "path": ["sessions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 204', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "pm.test('Strict CORS headers present', function () {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:3000');",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Credentials')).to.eql('true');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication & Identity",
      "item": [
        {
          "name": "Provision Anonymous Session (POST /api/v1/auth/session)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/session", "host": ["{{baseUrl}}"], "path": ["auth", "session"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('sessionId', json.sessionId);",
                  "pm.test('Returns valid anonymous sessionId', function () {",
                  "    pm.expect(json.sessionId).to.be.a('string');",
                  "    pm.expect(json.anonymous !== undefined ? json.anonymous : json.isAnonymous).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Retrieve Active Anonymous Session (GET /api/v1/auth/session/:id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/session/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["auth", "session", "{{sessionId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Session UUID matches environment', function () {",
                  "    pm.expect(json.sessionId).to.eql(pm.environment.get('sessionId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Student Account (POST /api/v1/auth/register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomEmail = 'student.' + Date.now() + '@escola.gov.br';",
                  "pm.environment.set('studentEmail', randomEmail);",
                  "pm.environment.set('studentPassword', 'Aprova2026!Secure');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns JWT token and userId', function () {",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.expect(json.userId).to.be.a('string');",
                  "    pm.expect(json.role).to.eql('ROLE_STUDENT');",
                  "    pm.environment.set('authToken', json.token);",
                  "    pm.environment.set('userId', json.userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"fullName\": \"Lucas Silva dos Santos\",\n  \"schoolType\": \"PUBLIC_SCHOOL\",\n  \"targetDegree\": \"Engenharia da Computacao\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Student Account (POST /api/v1/auth/login)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login returns active JWT', function () {",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.environment.set('authToken', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Authenticated User Profile (GET /api/v1/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Profile returns registered student details', function () {",
                  "    pm.expect(json.id).to.eql(pm.environment.get('userId'));",
                  "    pm.expect(json.role).to.eql('ROLE_STUDENT');",
                  "    pm.expect(json.schoolType).to.eql('PUBLIC_SCHOOL');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Export Personal Data (GET /api/v1/auth/export - LGPD Art. 18)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/export", "host": ["{{baseUrl}}"], "path": ["auth", "export"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns portable JSON data snapshot under LGPD Art. 18', function () {",
                  "    pm.expect(json.userId).to.eql(pm.environment.get('userId'));",
                  "    pm.expect(json.email).to.be.a('string');",
                  "    pm.expect(json.legalBasis).to.include('LGPD');",
                  "    pm.expect(json.privacyPolicyVersion).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Question Catalog",
      "item": [
        {
          "name": "List Questions (GET /api/v1/questions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/questions?page=0&size=5",
              "host": ["{{baseUrl}}"],
              "path": ["questions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns paginated question list', function () {",
                  "    pm.expect(json.items).to.be.an('array').that.is.not.empty;",
                  "    pm.environment.set('questionId', json.items[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Question Detail (GET /api/v1/questions/:id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/questions/{{questionId}}", "host": ["{{baseUrl}}"], "path": ["questions", "{{questionId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Contains statement and 5 options without answers leaked', function () {",
                  "    pm.expect(json.id).to.eql(pm.environment.get('questionId'));",
                  "    pm.expect(json.statement).to.be.a('string');",
                  "    pm.expect(json.options).to.have.lengthOf(5);",
                  "    json.options.forEach(opt => pm.expect(opt.isCorrect).to.be.null);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Question Status (PATCH /api/v1/questions/:id/status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"suspensionReason\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/questions/{{questionId}}/status", "host": ["{{baseUrl}}"], "path": ["questions", "{{questionId}}", "status"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('baseUrl') + '/auth/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            email: 'admin@aprovaenem.com.br',",
                  "            password: 'Password123!'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.environment.set('adminToken', res.json().token);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Question is marked ACTIVE', function () {",
                  "    pm.expect(json.status).to.eql('ACTIVE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
