    {
      "name": "6. Gamification & Leaderboards",
      "item": [
        {
          "name": "Get Student Profile (GET /api/v1/gamification/profile)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/gamification/profile", "host": ["{{baseUrl}}"], "path": ["gamification", "profile"] }
